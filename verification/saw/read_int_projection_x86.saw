let i8 = llvm_int 8;

let projection_relation_x86 = do {
    bytes <- llvm_fresh_var "bytes" (llvm_array 128 i8);
    marker <- llvm_fresh_var "marker" i8;
    p <- llvm_alloc_readonly_aligned 8 (llvm_array 128 i8);
    llvm_points_to p (llvm_term bytes);
    llvm_execute_func [p, llvm_term marker];
    llvm_return (llvm_term {{ 1 : [8] }});
};

m <- llvm_load_module "sized_int_equivalence_x86.bc";

c_port_projection_x86 <- llvm_verify m "saw_c_port_read_int_projection_equivalent" [] true projection_relation_x86 z3;
port_production_projection_x86 <- llvm_verify m "saw_port_production_read_int_projection_equivalent" [] true projection_relation_x86 z3;
c_production_projection_x86 <- llvm_verify m "saw_c_production_read_int_projection_equivalent" [] true projection_relation_x86 z3;

print "Apple x86 successful _readInt projection <-> both Rust implementations for all nibbles and aligned influencing bytes.";
