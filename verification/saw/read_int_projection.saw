import "SizedInt.cry";

let i8 = llvm_int 8;

// Successful `_readInt` calls have already validated the complete declared
// payload. Only the first 128 bytes can influence its value; widths at least
// 256 convert to zero at the uint8_t `_getSizedInt` parameter.
let projection_spec = do {
    bytes <- llvm_fresh_var "bytes" (llvm_array 128 i8);
    marker <- llvm_fresh_var "marker" i8;
    p <- llvm_alloc_readonly (llvm_array 128 i8);
    output <- llvm_alloc (llvm_array 16 i8);
    llvm_points_to p (llvm_term bytes);
    llvm_execute_func [p, llvm_term marker, output];
    llvm_points_to output
        (llvm_term {{ readIntSuccessProjection bytes marker }});
    llvm_return (llvm_term {{ 0 : [8] }});
};

let projection_relation = do {
    bytes <- llvm_fresh_var "bytes" (llvm_array 128 i8);
    marker <- llvm_fresh_var "marker" i8;
    p <- llvm_alloc_readonly (llvm_array 128 i8);
    llvm_points_to p (llvm_term bytes);
    llvm_execute_func [p, llvm_term marker];
    llvm_return (llvm_term {{ 1 : [8] }});
};

m <- llvm_load_module "sized_int_equivalence_generic.bc";

c_projection <- llvm_verify m "saw_apple_read_int_success_projection" [] true projection_spec z3;
port_projection <- llvm_verify m "saw_port_read_int_success_projection" [] true projection_spec z3;
production_projection <- llvm_verify m "saw_production_read_int_success_projection" [] true projection_spec z3;

c_port_projection <- llvm_verify m "saw_c_port_read_int_projection_equivalent" [] true projection_relation z3;
port_production_projection <- llvm_verify m "saw_port_production_read_int_projection_equivalent" [] true projection_relation z3;
c_production_projection <- llvm_verify m "saw_c_production_read_int_projection_equivalent" [] true projection_relation z3;

print "Successful _readInt value/cursor projection adapter: C <-> Rust port <-> production Rust for all nibbles and influencing bytes.";
