let i8 = llvm_int 8;

// Each relational adapter receives the same symbolic allocation and width.
// Since width has type [8], this covers every integer from 0 through 255.
let all_widths_relation = do {
    bytes <- llvm_fresh_var "bytes" (llvm_array 255 i8);
    width <- llvm_fresh_var "width" i8;
    p <- llvm_alloc_readonly (llvm_array 255 i8);
    llvm_points_to p (llvm_term bytes);
    llvm_execute_func [p, llvm_term width];
    llvm_return (llvm_term {{ 1 : [8] }});
};

m <- llvm_load_module "sized_int_equivalence_generic.bc";

c_port <- llvm_verify m "saw_c_port_equivalent_n" [] true all_widths_relation z3;
port_production <- llvm_verify m "saw_port_production_equivalent_n" [] true all_widths_relation z3;
c_production <- llvm_verify m "saw_c_production_equivalent_n" [] true all_widths_relation z3;

print "C <-> Rust port <-> production Rust: all widths 0..255 and all input bytes proved equivalent.";
